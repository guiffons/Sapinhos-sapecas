// 5. DUAL-LAYER CO-OP NETWORKING (PEERJS WEBRTC + BROADCASTCHANNEL)
// =============================================================================
class NetRoom{
  constructor(code){
    this.code=code;this.handlers={};this.conns=[];this.peer=null;this.bc=null;this.ok=false;
  }
  on(t,fn){(this.handlers[t]=this.handlers[t]||[]).push(fn)}
  trigger(t,data,isMe=false){(this.handlers[t]||[]).forEach(fn=>fn({data,isMe}))}
  connected(){return this.ok}
  async connect(onStatus){
    try{
      this.bc=new BroadcastChannel('sapinhos_net_'+this.code);
      this.bc.onmessage=ev=>{const m=ev.data;if(m&&m.t)this.trigger(m.t,m.d,false)};
      this.ok=true;
    }catch(e){}
    if(typeof Peer==='undefined'){onStatus('Sala local ativa (abas).');return true;}
    const hostId='sapinhos-sapecas-v1-'+this.code;
    return new Promise(resolve=>{
      let settled=false;
      const done=(msg)=>{if(!settled){settled=true;this.ok=true;onStatus(msg);resolve(true)}};
      try{
        const p=new Peer(hostId,{debug:0});
        this.peer=p;
        p.on('open',()=>{
          done('Sala Online criada! Passe o código ao amigo.');
        });
        p.on('connection',conn=>{
          this.setupConn(conn);
          unlockAch('coop');
        });
        p.on('error',err=>{
          if(err.type==='unavailable-id'){
            try{p.destroy()}catch(e){}
            const cp=new Peer({debug:0});
            this.peer=cp;
            cp.on('open',()=>{
              const conn=cp.connect(hostId,{reliable:false});
              this.setupConn(conn);
              conn.on('open',()=>{unlockAch('coop');done('Conectado ao amigo via WebRTC!')});
              setTimeout(()=>done('Conectado em sala híbrida!'),1800);
            });
            cp.on('error',()=>done('Modo Co-op Local ativo.'));
          }else{
            done('Modo Co-op Local ativo.');
          }
        });
        setTimeout(()=>done('Sala pronta!'),2200);
      }catch(e){done('Modo Co-op Local ativo.')}
    });
  }
  setupConn(conn){
    this.conns.push(conn);
    conn.on('data',m=>{if(m&&m.t){this.trigger(m.t,m.d,false);unlockAch('coop')}});
    conn.on('close',()=>{this.conns=this.conns.filter(c=>c!==conn)});
  }
  async emit(t,d){
    const pkt={t,d};
    if(this.bc)try{this.bc.postMessage(pkt)}catch(e){}
    for(const c of this.conns)if(c.open)try{c.send(pkt)}catch(e){}
  }
  async leave(){
    if(this.bc)try{this.bc.close()}catch(e){}
    for(const c of this.conns)try{c.close()}catch(e){}
    if(this.peer)try{this.peer.destroy()}catch(e){}
    this.ok=false;
  }
}

