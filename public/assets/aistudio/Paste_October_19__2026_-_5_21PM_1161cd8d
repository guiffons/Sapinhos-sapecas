  for(const w of hazards(wd.rm).water){
    if(((x-w.x)/w.rx)**2+((y-w.y)/w.ry)**2<=1)return true;
  }
  return false;
}
function pushOut(o,r){
  if(o.fly)return;
  for(const k of rocks(wd.rm)){
    const cx=clamp(o.x,k.x+2,k.x+30),cy=clamp(o.y,k.y+2,k.y+30),dx=o.x-cx,dy=o.y-cy,d=Math.hypot(dx,dy);
    if(d<r){if(d>.01){o.x+=dx/d*(r-d);o.y+=dy/d*(r-d)}else o.y-=r}
  }
}

