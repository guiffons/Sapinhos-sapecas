function newRoom(){
  me.x=240+(Math.random()-.5)*60;me.y=H-M-24;
  myB=[];rB=[];BEAMS=[];POOLS=[];DROPS=[];DC.length=0;tr=1;me.j=-.45;roomDamaged=false;
  if(me.dead){me.dead=false;me.hp=2}else me.hp=Math.min(me.mh,me.hp+1);
  if(me.shi)me.sh=1;
  me.inv=1.5;nextT=now()+800;dust(me.x,me.y+10,'#81c784',8);
}

function spawnBullet(x,y,a,w,dmgMult=1){
  const vx=Math.cos(a)*w.sp+me.mvx*.28,vy=Math.sin(a)*w.sp+me.mvy*.28,r=w.r*me.big;
  const bObj={
    x,y,ox:x,oy:y,vx,vy,l:w.l||1.15,r,
    d:w.dm*me.dm*(me.big>1?1.3:1)*dmgMult,
    p:w.pi||me.pr||w.tng,bnc:(w.bnc||0)+me.bnc,
    aoe:(w.aoe||0)+(me.exp?26:0),pool:w.pool||me.tox,
    tng:w.tng,oid:me.id,w:me.w,col:w.col,hit:[],ka:a
  };
  myB.push(bObj);
  if(R&&R.connected()){
    R.emit('sh',{
      x:x|0,y:y|0,vx:vx|0,vy:vy|0,r:Math.round(r*10)/10,w:me.w,l:bObj.l,
      tng:w.tng?1:0,oid:me.id,aoe:bObj.aoe,pool:bObj.pool?1:0,bnc:bObj.bnc,col:w.col
    }).catch(()=>{});
  }
}

function fireBeam(x,y,a,w){
  const bw=6*me.big;
  BEAMS.push({x,y,a,col:w.col,l:.22,m:.22,w:bw});
  if(R&&R.connected()){
    R.emit('sh',{beam:1,x:x|0,y:y|0,a:Math.round(a*100)/100,col:w.col,bw}).catch(()=>{});
  }
  const dx=Math.cos(a),dy=Math.sin(a),dmg=w.dm*me.dm*(me.big>1?1.3:1);
  for(const e of wd.en){
    const vx=e.x-x,vy=e.y-y,proj=vx*dx+vy*dy;
    if(proj>0&&proj<460){
      const perp=Math.abs(vx*dy-vy*dx);
      if(perp<RAD[e.t]+8*me.big){
        sendE('hit',{i:e.id,d:dmg,kx:dx*9,ky:dy*9});
        hitFx(e,{x:e.x,y:e.y,d:dmg,w:5});
      }
    }
  }
}

function fire(){
  const w=WP[me.w],q=Math.hypot(me.ax,me.ay)||1,dx=me.ax/q,dy=me.ay/q;
  const baseA=Math.atan2(dy,dx),n=(w.n||1)+(me.tri?2:0);
  me.puff=.18;

  const dirs=[baseA];
  if(me.rear)dirs.push(baseA+Math.PI);

  for(const dA of dirs){
    for(let i=0;i<n;i++){
      const a=dA+(n>1?(i-(n-1)/2)*.24:0)+(w.jit?(Math.random()-.5)*w.jit:0);
      if(w.beam)fireBeam(me.x+Math.cos(a)*10,me.y-6+Math.sin(a)*10,a,w);
      else spawnBullet(me.x+Math.cos(a)*8,me.y-6+Math.sin(a)*8,a,w);
    }
  }
  if(me.fam){
    for(let f=0;f<me.fam;f++){
      const fa=TT*3.5+f*3.14,fx=me.x+Math.cos(fa)*24,fy=me.y+Math.sin(fa)*18;
      spawnBullet(fx,fy,baseA,WP[0],.55);
    }
  }

  me.cd=me.rt*w.rt;
  me.v+=me.w>=4?-9:-4.5;
  snd(me.w==5?140:me.w==4?115:me.w==3?620:390,.09,me.w>=4?'sawtooth':'square',.04,-130);
  // Spit muzzle burst + bouncing spit droplets on floor!
  pt(me.x+dx*10,me.y-6+dy*10,w.col,4,55,.22,2);
  pt(me.x+dx*8,me.y-4,w.col,2,45,.55,2.2,220,1);
  if(me.w>=4){me.x-=dx*3.5;me.y-=dy*3.5;addShake(3.5)}
}

function got(k){
  me.its.push(k);let s=IT[k][0];
  if(k==0)me.dm+=.9;
  else if(k==1)me.rt=Math.max(.1,me.rt*.8);
  else if(k==2){me.mh+=2;me.hp=me.mh}
  else if(k==3)me.sp+=15;
  else if(k==4)me.pr=1;
  else if(k==5)me.hm=1;
  else if(k==6){me.shi=1;me.sh=1}
  else if(k==7)me.big=1.65;
  else if(k==8)me.tri=1;
  else if(k==9)me.tox=1;
  else if(k==10)me.bnc+=2;
  else if(k==11){me.fam++;unlockAch('fam')}
  else if(k==12)me.vmp=1;
  else if(k==13){me.fly=1;unlockAch('fly_high')}
  else if(k==14){me.w=(me.w+1+((Math.random()*5)|0))%WP.length;me.dm+=.4;s=WP[me.w].nm.toUpperCase()}
  else if(k==15)me.exp=1;
  else if(k==16)me.rear=1;
  else if(k==17){me.dm+=.6;me.rt=Math.max(.1,me.rt*.88);me.mh+=2;me.hp=Math.min(me.mh,me.hp+2);me.sp+=10}

  achStats.maxItems=Math.max(achStats.maxItems,me.its.length);
  achStats.maxDmg=Math.max(achStats.maxDmg,me.dm);
  saveProgress();

  if(me.its.length>=3)unlockAch('it3');
  if(me.its.length>=5)unlockAch('synergy');
  if(me.dm>=4.5)unlockAch('big_dmg');

  FT.push({x:me.x,y:me.y-30,s,c:'#ffd54f',l:1.6,b:1});
  snd(520,.35,'triangle',.08,700);pt(me.x,me.y,'#ffd54f',26,120,.6,3);me.v+=9;addShake(3);
}

function hitFx(e,b){
  e.fl=.12;e.v+=7.5;pt(b.x,b.y,CL[e.t]||'#66bb6a',5,80,.35,2.5,150);
  FT.push({x:e.x,y:e.y-14,s:String(Math.round(b.d*10)/10),c:'#fff',l:.6});
  snd(190+Math.random()*60,.07,'square',.04,-80);
  addShake(b.w>=4?6.5:1.5);if(b.w>=4)addHs(.045);
}

function triggerAoE(b,isRemote=false){
  if(b.pool)POOLS.push({x:b.x,y:b.y,r:24,l:3.2,tk:0,c:'#76ff03'});
  if(b.aoe){
    pt(b.x,b.y,WP[b.w]?.col||'#76ff03',16,110,.45,3);snd(130,.16,'sawtooth',.05,-60);
    if(!isRemote){
      for(const e of wd.en)if(Math.hypot(e.x-b.x,e.y-b.y)<RAD[e.t]+b.aoe){
        sendE('hit',{i:e.id,d:b.d*.65,kx:0,ky:0});
      }
    }
  }
}

