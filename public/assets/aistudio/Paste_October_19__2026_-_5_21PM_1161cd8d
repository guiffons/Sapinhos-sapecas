function E(t,x,y,chmp=0){
  const bo=t.startsWith('B');
  const scaleHp=1+(wd.rm*0.045);
  const baseHp=Math.round((HP[t]||12)*(bo?1:scaleHp)*(chmp?1.5:1));
  return{
    id:rnd(),t,x,y,rx:x,hp:baseHp,mh:baseHp,
    c:.8+Math.random()*1.1,j:0,v:0,fl:0,chmp:chmp?1:0,
    seg:t=='B2'?Array.from({length:6},()=>({x,y})):null
  };
}
const BIOME_POOLS=[
  ['f','g','s','spd'],
  ['g','s','c','m','bmb'],
  ['s','c','m','plt','snk'],
  ['c','m','bmb','plt','gho','snk'],
  ['bmb','plt','snk','gho','spd','c']
];

function genRoomItems(rm){
  const r=sr(rm*313+77);
  const a=(r()*IT.length)|0;
  const b=(a+1+((r()*(IT.length-1))|0))%IT.length;
  return[{x:196,y:170,k:a},{x:284,y:170,k:b}];
}

function spawn(rm){
  wd.rm=rm;wd.init=true;wd.clear=false;wd.items=[];wd.eb=[];wd.en=[];POOLS.length=0;DROPS.length=0;
  const bIdx=biomeOf(rm);
  if(isBossRm(rm)){
    wd.en.push(E('B'+bIdx,240,108,0));
    return;
  }
  const n=3+bIdx+(rm%3)+(act().length?2:0),pl=BIOME_POOLS[bIdx];
  const chmpChance=Math.min(0.38,rm*0.03);
  for(let i=0;i<n;i++){
    let x,y,k=0;
    do{x=58+Math.random()*364;y=48+Math.random()*115}while(inRock(x,y)&&k++<15);
    const isChmp=rm>=1&&Math.random()<chmpChance?1:0;
    wd.en.push(E(pl[(Math.random()*pl.length)|0],x,y,isChmp));
  }
}
function shoot(e,dx,dy,v){wd.eb.push({id:rnd(),x:e.x,y:e.y,vx:dx*v,vy:dy*v})}

function hostUpd(dt){
  if(!wd.init){spawn(wd.rm);return}
  if(wd.over)return;
  const T=[];if(!me.dead)T.push(me);for(const o of act())if(!o.d)T.push({x:o.x,y:o.y});
  const aggr=1+wd.rm*0.025; // Progressive aggressiveness as wd.rm advances (1..15)
  if(T.length)for(const e of wd.en){
    e.c=(e.c??1)-dt*aggr;
    let tg=T[0],bd=1e12;
    for(const p of T){const d=(p.x-e.x)**2+(p.y-e.y)**2;if(d<bd){bd=d;tg=p}}
    const dx=tg.x-e.x,dy=tg.y-e.y,l=Math.hypot(dx,dy)||1,ux=dx/l,uy=dy/l;
    let sp=({f:56,g:34,s:16,c:28,bmb:44,plt:0,snk:68,gho:30,spd:22,B0:28,B1:40,B2:80,B3:22,B4:35}[e.t]||0)*aggr*(e.chmp?1.12:1);

    if(e.t=='m'||e.t=='n')sp=(e.t=='m'?85:115)*Math.max(0,Math.sin(Date.now()/(e.t=='m'?330:240)+e.id))*aggr;
    if(e.t=='c'){
      if(e.dash>0){e.dash-=dt;e.x+=e.dx*255*dt;e.y+=e.dy*255*dt;sp=0;if(e.dash<=0)e.c=1.3+Math.random()*.8}
      else if(e.tel>0){sp=0;e.tel-=dt;if(e.tel<=0)e.dash=.48}
      else if(e.c<=0){e.tel=.5;e.dx=ux;e.dy=uy}
    }
    if(e.t=='snk'){
      const px=-uy,py=ux,wob=Math.sin(TT*9+e.id)*55;
      e.x+=(ux*sp+px*wob)*dt;e.y+=(uy*sp+py*wob)*dt;sp=0;
    }
    if(e.t=='spd'&&e.c<=0){
      e.c=.8+Math.random()*.45;e.x+=ux*44;e.y+=uy*44;e.j=-.35;
    }
    if(e.t=='gho'&&e.c<=0){
      e.c=2.0;e.x=clamp(tg.x+(Math.random()-.5)*110,M+20,W-M-20);e.y=clamp(tg.y+(Math.random()-.5)*90,M+20,H-M-20);
      shoot(e,ux,uy,110);
      if(e.chmp)shoot(e,-ux,-uy,110);
    }
    if(e.t=='plt'&&e.c<=0){
      e.c=1.65;
      const cnt=e.chmp?6:4;
      for(let k=0;k<cnt;k++){const a=.785+k*(6.283/cnt);shoot(e,Math.cos(a),Math.sin(a),98)}
    }
    if(e.t=='bmb'&&l<48)e.tel=1;else if(e.t=='bmb')e.tel=0;

    e.x+=ux*sp*dt;e.y+=uy*sp*dt;
    if(e.t=='f'||e.t=='B1')e.x+=Math.sin(Date.now()/160+e.id)*38*dt;
    if(e.t=='s'&&e.c<=0){
      e.c=1.5;shoot(e,ux,uy,115);
      if(e.chmp){
        const ba=Math.atan2(uy,ux);
        shoot(e,Math.cos(ba+.25),Math.sin(ba+.25),110);
        shoot(e,Math.cos(ba-.25),Math.sin(ba-.25),110);
      }
    }

    // 5 UNIQUE DYNAMIC BULLET-HELL BOSS AIs
    if(e.t.startsWith('B')){
      const p2=e.hp<e.mh*.5;
      if(e.t=='B0'){ // Rei Sapo-Boi: Jump slams + radial spit + aimed triple + tadpoles
        if(e.c<=0){
          e.c=p2?1.15:1.65;e.j=-.45;e.st=(e.st||0)+1;
          const n=p2?14:10,a0=e.st*.4;
          for(let i=0;i<n;i++){const a=a0+i*6.283/n;shoot(e,Math.cos(a),Math.sin(a),98)}
          if(e.st%2===0){
            const ba=Math.atan2(uy,ux);
            for(let k=-1;k<=1;k++)shoot(e,Math.cos(ba+k*.2),Math.sin(ba+k*.2),130);
          }
          if(p2&&wd.en.length<4)wd.en.push(E('n',e.x+20,e.y+20));
        }
      }else if(e.t=='B1'){ // Rainha Vespeiro: Double Spiral Stinger Bullet Hell + Flies
        if(e.c<=0){
          e.c=p2?.32:.5;e.ang=(e.ang||0)+.52;
          const arms=p2?5:3;
          for(let i=0;i<arms;i++){const a=e.ang+i*6.283/arms;shoot(e,Math.cos(a),Math.sin(a),120)}
          if(Math.random()<.16&&wd.en.length<5)wd.en.push(E('f',e.x,e.y+24));
        }
      }else if(e.t=='B2'){ // Leviatã do Esgoto: Slithering multi-segment serpent + venom fan
        e.ang=(e.ang||0)+dt*(p2?2.7:1.9);
        e.x+=Math.cos(e.ang)*98*dt;e.y+=Math.sin(e.ang*1.3)*78*dt;
        if(e.seg){
          let px=e.x,py=e.y;
          for(const sg of e.seg){
            const sdx=px-sg.x,sdy=py-sg.y,sd=Math.hypot(sdx,sdy)||1;
            if(sd>14){sg.x+=sdx/sd*(sd-14);sg.y+=sdy/sd*(sd-14)}
            px=sg.x;py=sg.y;
          }
        }
        if(e.c<=0){
          e.c=p2?.9:1.35;
          const fan=p2?2:1;
          for(let i=-fan;i<=fan;i++){const a=Math.atan2(uy,ux)+i*.22;shoot(e,Math.cos(a),Math.sin(a),130)}
        }
      }else if(e.t=='B3'){ // Golem de Jade: Alternating Cross Salvos + Heavy Ring
        if(e.c<=0){
          e.c=p2?1.0:1.5;e.ang=(e.ang||0)+.42;
          const n=p2?16:12;
          for(let i=0;i<n;i++){const a=e.ang+i*6.283/n;shoot(e,Math.cos(a),Math.sin(a),105)}
          const ba=Math.atan2(uy,ux);
          shoot(e,Math.cos(ba),Math.sin(ba),145);
        }
      }else if(e.t=='B4'){ // O Grande Ancião Anfíbio: Final Boss Multi-pattern Bullet Hell
        if(e.c<=0){
          e.c=p2?.85:1.3;const n=p2?18:12,a0=TT*2.2;
          for(let i=0;i<n;i++){const a=a0+i*6.283/n;shoot(e,Math.cos(a),Math.sin(a),p2?120:98)}
          for(let i=-1;i<=1;i++){const a=Math.atan2(uy,ux)+i*.18;shoot(e,Math.cos(a),Math.sin(a),150)}
          if(p2&&wd.en.length<5&&Math.random()<.35)wd.en.push(E('bmb',e.x,e.y+28));
        }
      }
    }
    e.x=clamp(e.x,M+14,W-M-14);e.y=clamp(e.y,M+14,H-M-14);
  }
  for(const b of wd.eb){b.x+=b.vx*dt;b.y+=b.vy*dt}
  wd.eb=wd.eb.filter(b=>b.x>M-4&&b.x<W-M+4&&b.y>M-4&&b.y<H-M+4&&!inRock(b.x,b.y)).slice(-80);

  if(!wd.clear&&!wd.en.length){
    wd.clear=true;
    if(!roomDamaged)unlockAch('untouch');
    if(wd.rm==MAX_RM){wd.over='win';unlockAch('win')}
    else{
      wd.items=genRoomItems(wd.rm);
    }
  }
}

function deathFx(e){
  const bo=e.t.startsWith('B');
  pt(e.x,e.y,CL[e.t]||'#66bb6a',bo?75:(e.chmp?30:18),bo?175:115,.8,3.5,220);
  pt(e.x,e.y,'#fff',bo?24:6,95,.3,2);
  addShake(bo?16:(e.chmp?7:4.5));addHs(bo?.24:(e.chmp?.09:.05));
  snd(bo?85:210,bo?.6:.2,'sawtooth',.07,-60);
  DC.push({x:e.x,y:e.y+8,c:CL[e.t]||'#4caf50',r:bo?18:(e.chmp?11:6+Math.random()*7)});
  if(DC.length>45)DC.shift();

  // Champion enemies drop extra healing heart on death!
  if(e.chmp){
    DROPS.push({id:rnd(),x:e.x,y:e.y,j:0,v:8});
    FT.push({x:e.x,y:e.y-16,s:'CAMPEÃO DERROTADO!',c:'#ffd54f',l:1.0});
  }

  achStats.kills++;unlockAch('first_blood');
  if(achStats.kills>=20)unlockAch('k20');
  else saveProgress();
  if(e.t=='B0')unlockAch('b1');
  if(e.t=='B1')unlockAch('b2');
  if(e.t=='B2')unlockAch('b3');
  if(e.t=='B3')unlockAch('b4');

  if(me.vmp){
    me.kills++;
    if(me.kills%8===0&&me.hp<me.mh){
      me.hp++;FT.push({x:me.x,y:me.y-24,s:'+1 VIDA!',c:'#ff5252',l:.9});
    }
  }
}

function handle(t,d){
  if(t=='rs'){reset();return}
  if(t=='pick'){
    if(d&&d.k!=null){
      pt(d.x||240,d.y||170,'#ffd54f',26,120,.6,3);
      if(d.pid&&d.pid!==me.id){
        snd(520,.28,'triangle',.06,500);
        FT.push({x:d.x||240,y:(d.y||170)-26,s:`${d.who||'PARCEIRO'}: ${IT[d.k][0]}`,c:'#ffd54f',l:1.6,b:1});
      }
    }
    if(act().length>0&&d&&d.x!=null){
      wd.items=wd.items.filter(i=>Math.abs(i.x-d.x)>8);
    }else{
      wd.items=[];
    }
    return;
  }
  if(!isHost())return;
  if(t=='hit'){
    const e=wd.en.find(e=>e.id==d.i);
    if(e){
      e.hp-=d.d;e.x+=d.kx||0;e.y+=d.ky||0;
      if(e.hp<=0){
        wd.en=wd.en.filter(x=>x!==e);deathFx(e);
        if(e.t=='m')wd.en.push(E('n',e.x-10,e.y),E('n',e.x+10,e.y));
        if(e.t=='bmb'){
          for(let i=0;i<8;i++){const a=i*6.283/8;shoot(e,Math.cos(a),Math.sin(a),105)}
        }
      }
    }
  }
  else if(t=='ebx')wd.eb=wd.eb.filter(b=>b.id!=d.i);
  else if(t=='next'&&wd.clear&&wd.rm<MAX_RM&&!wd.over)spawn(wd.rm+1);
}
function sendE(t,d){if(R&&R.connected())R.emit(t,d).catch(()=>{});handle(t,d||{})}

function onMsg(t,m){
  const d=m.data;
  if(t=='s'){
    if(m.isMe||!d||d.id==me.id)return;
    const o=others[d.id];
    others[d.id]={...d,rx:o?o.rx:d.x,ry:o?o.ry:d.y,j:d.j??(o?o.j:0),v:o?o.v:0,t:now()};return;
  }
  if(t=='w'){
    if(!d||d.h==me.id||isHost())return;
    const old=Object.fromEntries(wd.en.map(e=>[e.id,e])),ids=new Set(d.en.map(a=>a[0]));
    for(const id in old)if(!ids.has(+id)&&!wd.over&&d.rm==wd.rm)deathFx(old[id]);
    wd.rm=d.rm;wd.init=true;wd.clear=!!d.c;wd.items=d.it.map(a=>({x:a[0],y:a[1],k:a[2]}));wd.over=d.o||'';
    wd.en=d.en.map(a=>{
      const o=old[a[0]]||{};
      const chmp=a[6]||0;
      const baseMh=Math.round((HP[a[1]]||200)*(a[1].startsWith('B')?1:(1+wd.rm*0.045))*(chmp?1.5:1));
      return{id:a[0],t:a[1],x:a[2],y:a[3],hp:a[4],mh:o.mh||baseMh,tel:a[5],chmp,rx:o.rx??a[2],j:o.j||0,v:o.v||0,fl:o.fl||0,seg:o.seg||(a[1]=='B2'?Array.from({length:6},()=>({x:a[2],y:a[3]})):null)};
    });
    wd.eb=d.eb.map(a=>({id:a[0],x:a[1],y:a[2],vx:a[3],vy:a[4]}));return;
  }
  if(t=='sh'){
    if(!m.isMe&&d){
      if(d.beam){
        BEAMS.push({x:d.x,y:d.y,a:d.a,col:d.col||'#e040fb',l:.22,m:.22,w:d.bw||6});
        snd(140,.09,'sawtooth',.03,-100);
      }else{
        rB.push({
          x:d.x,y:d.y,ox:d.x,oy:d.y,vx:d.vx,vy:d.vy,
          r:d.r||4,w:d.w||0,l:d.l||.95,
          tng:d.tng||0,oid:d.oid,aoe:d.aoe||0,pool:d.pool||0,bnc:d.bnc||0,col:d.col
        });
      }
    }
    return;
  }
  handle(t,d||{});
}

