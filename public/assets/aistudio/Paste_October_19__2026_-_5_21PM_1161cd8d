// Deterministic Tactical Room Obstacles & Hazards per Room
const RK={},HZ={};
function buildRoomLayout(rm){
  if(RK[rm])return;
  const r=sr(rm*97+23),a=[],hz={water:[],spikes:[]};
  const addBlk=(cx,cy)=>{
    if(cx>=5&&cx<=7&&(cy<=1||cy>=6))return; // Keep spawn & door clear
    if(!a.some(q=>q.cx==cx&&q.cy==cy))a.push({cx,cy,x:M+cx*32,y:M+cy*32});
  };
  if(!isBossRm(rm)){
    const lay=roomLayout(rm);
    if(lay===0){
      // 1. Arena de Pilares Simétricos (4 corner pillars)
      [[2,1],[10,1],[2,5],[10,5],[3,2],[9,2],[3,5],[9,5]].forEach(([x,y])=>addBlk(x,y));
      if(r()>.4){addBlk(6,3)}
    }else if(lay===1){
      // 2. Labirinto Cruzado (Central cover + tactical corridors)
      [[5,3],[6,3],[7,3],[3,1],[9,1],[3,5],[9,5],[1,3],[11,3]].forEach(([x,y])=>addBlk(x,y));
    }else if(lay===2){
      // 3. Ilhas de Lodo / Água Profunda (Slows non-flying frogs by 35%)
      hz.water.push(
        {x:M+48,y:M+42,rx:68,ry:42},
        {x:W-M-48,y:M+42,rx:68,ry:42},
        {x:240,y:156,rx:74,ry:38}
      );
      [[3,2],[9,2],[4,5],[8,5]].forEach(([x,y])=>addBlk(x,y));
    }else if(lay===3){
      // 4. Sala de Armadilhas (Retractable spike blocks every 2.5s)
      [[4,2],[8,2],[4,4],[8,4],[6,2],[6,4],[2,3],[10,3]].forEach(([cx,cy])=>{
        hz.spikes.push({cx,cy,x:M+cx*32+16,y:M+cy*32+16});
      });
      [[2,1],[10,1],[2,5],[10,5]].forEach(([x,y])=>addBlk(x,y));
    }
  }else{
    // Boss arena subtle corner mud/water puddles
    hz.water.push({x:M+44,y:M+44,rx:36,ry:24},{x:W-M-44,y:M+44,rx:36,ry:24});
  }
  RK[rm]=a;HZ[rm]=hz;
}
function rocks(rm){buildRoomLayout(rm);return RK[rm]}
function hazards(rm){buildRoomLayout(rm);return HZ[rm]}
const spikesUp=()=>((TT%2.5)>1.45);
const spikesWarn=()=>((TT%2.5)>1.1&&!spikesUp());

