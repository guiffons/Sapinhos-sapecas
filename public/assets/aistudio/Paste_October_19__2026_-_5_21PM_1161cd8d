$('title').innerHTML=[...'SAPINHOS SAPECAS'].map((c,i)=>`<span style="--i:${i}">${c===' '?'&nbsp;':c}</span>`).join('');

function makeBars(val,max=5,gold=false){
  let s='<span class="stat-bars">';
  for(let i=0;i<max;i++)s+=`<i class="${i<val?'on'+(gold?' gold':''):''}"></i>`;
  return s+'</span>';
}

function renderCarousel(){
  const box=$('carousel');box.innerHTML='';
  const N=CH.length;
  CH.forEach((c,i)=>{
    let diff=i-ch;
    if(diff>N/2)diff-=N;
    if(diff<-N/2)diff+=N;
    const ang=diff*(Math.PI*2/N);
    const rx=Math.sin(ang)*10.2;
    const ry=Math.cos(ang)*2.3;
    const sc=.58+(Math.cos(ang)+1)*.32;
    const z=Math.round(sc*100);
    const unlocked=isCharUnlocked(i);

    const slot=document.createElement('div');
    slot.className='frog-slot'+(i===ch?' active':'');
    slot.style.transform=`translate(calc(-50% + ${rx}em), calc(-50% + ${ry}em)) scale(${sc})`;
    slot.style.zIndex=z;
    slot.style.opacity=unlocked?(0.45+sc*0.55):0.65;

    const k=document.createElement('canvas');
    const spSrc=unlocked?S.pIdle[i]:sil(S.pIdle[i],'#16241b');
    k.width=spSrc.width;k.height=spSrc.height;
    k.style.width='3.6em';
    const kx=k.getContext('2d');kx.imageSmoothingEnabled=false;
    kx.drawImage(spSrc,0,0);
    if(!unlocked)kx.drawImage(S.lock,k.width/2-S.lock.width/2,k.height/2-S.lock.height/2);

    const ped=document.createElement('div');ped.className='slot-ped';
    slot.append(k,ped);
    slot.onclick=()=>{selectFrog(i)};
    box.append(slot);
  });

  const cur=CH[ch],unlocked=isCharUnlocked(ch);
  $('ci-name').textContent=unlocked?cur.n:`??? (${cur.n})`;
  $('ci-title').textContent=cur.t;
  $('ci-wp').textContent=WP[cur.wp].nm;
  $('ci-pas').textContent=cur.pas;

  const hpBar=Math.round(cur.hp/2);
  const dmBar=clamp(Math.round(cur.dm*1.6),1,5);
  const rtBar=clamp(Math.round((0.5-cur.rt)*16),1,5);
  const spBar=clamp(Math.round((cur.sp-65)/14),1,5);
  $('ci-stats').innerHTML=`
    <div class="stat-item"><span>VIDA</span>${makeBars(hpBar,5)}</div>
    <div class="stat-item"><span>DANO</span>${makeBars(dmBar,5,true)}</div>
    <div class="stat-item"><span>CADÊNCIA</span>${makeBars(rtBar,5)}</div>
    <div class="stat-item"><span>VELOC.</span>${makeBars(spBar,5)}</div>
  `;
  const lk=$('ci-lock');
  if(!unlocked){
    lk.style.display='block';lk.textContent='BLOQUEADO — '+cur.reqTxt;
    $('solo').disabled=true;$('go').disabled=true;
  }else{
    lk.style.display='none';
    $('solo').disabled=false;$('go').disabled=false;
  }
}

function selectFrog(i){
  ch=(i+CH.length)%CH.length;
  snd(440+ch*75,.1,'triangle',.07,180);
  renderCarousel();
}
$('prev-ch').onclick=()=>selectFrog(ch-1);
$('next-ch').onclick=()=>selectFrog(ch+1);

