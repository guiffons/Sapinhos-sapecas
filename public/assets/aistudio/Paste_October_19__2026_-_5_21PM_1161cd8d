// 11. MAIN UPDATE LOOP
// =============================================================================
function upd(dt,rdt){
  if(paused)return;
  TT+=dt;if(wd.rm!==lastRm){lastRm=wd.rm;newRoom()}
  if(wd.over&&!prevOver){
    for(let i=0;i<6;i++)setTimeout(()=>pt(60+Math.random()*360,60+Math.random()*110,['#76ff03','#ffd54f','#00e5ff','#ff4081'][i%4],32,165,1.2,3,160),i*170);
    snd(520,.5,'triangle',.1,600);
  }
  prevOver=wd.over;

  for(const k in others)if(now()-others[k].t>5500)delete others[k];
  for(const o of Object.values(others)){
    const sp=Math.hypot(o.x-o.rx,o.y-o.ry);
    o.rx+=(o.x-o.rx)*.35;o.ry+=(o.y-o.ry)*.35;
    if(sp>0.8&&Math.random()<dt*8)dust(o.rx,o.ry+12,'#80cbc4',1);
    o.v+=sp*.3*Math.sin(TT*30)*dt*60*.02;spring(o,dt);
  }
  if(isHost())hostUpd(rdt);else for(const b of wd.eb){b.x+=b.vx*dt;b.y+=b.vy*dt}
  for(const e of wd.en){
    const mv=Math.abs((e.x-(e.rx??e.x)));
    e.rx=e.rx==null?e.x:e.rx+(e.x-e.rx)*.4;e.fl-=dt;spring(e,dt);
    if(mv>0.3&&!e.t.startsWith('f')&&Math.random()<dt*5)pt(e.rx,e.y+10,CL[e.t]||'#66bb6a',1,20,.25,1.8);
  }

  // Update Acid Pools
  for(const pl of POOLS){
    pl.l-=dt;pl.tk-=dt;
    if(pl.tk<=0){
      pl.tk=.35;
      for(const e of wd.en)if(Math.hypot(e.x-pl.x,e.y-pl.y)<RAD[e.t]+pl.r){
        sendE('hit',{i:e.id,d:.8,kx:0,ky:0});e.fl=.06;
      }
    }
  }
  for(let i=POOLS.length-1;i>=0;i--)if(POOLS[i].l<=0)POOLS.splice(i,1);
  for(let i=BEAMS.length-1;i>=0;i--){BEAMS[i].l-=dt;if(BEAMS[i].l<=0)BEAMS.splice(i,1)}

  // Remote Co-op Shots with Bounces, Pools & AoE
  for(const b of rB){
    b.x+=b.vx*dt;b.y+=b.vy*dt;b.l-=dt;
    if(Math.random()<.4)pt(b.x,b.y,b.col||WP[b.w]?.col||'#76ff03',1,14,.22,1.5);
    const hitX=b.x<M||b.x>W-M,hitY=b.y<M||b.y>H-M,hitRk=inRock(b.x,b.y);
    if(hitX||hitY||hitRk){
      if(b.bnc>0&&!b.tng){
        b.bnc--;if(hitX)b.vx*=-1;if(hitY||hitRk)b.vy*=-1;
        b.x=clamp(b.x,M+2,W-M-2);b.y=clamp(b.y,M+2,H-M-2);
      }else{
        b.l=0;triggerAoE(b,true);pt(b.x,b.y,b.col||WP[b.w]?.col||'#76ff03',4,50,.25,2);
      }
    }
  }
  rB=rB.filter(b=>b.l>0);

  spring(me,dt);fl=Math.max(0,fl-dt*2);hint-=rdt;me.puff=Math.max(0,me.puff-dt);

  if(!me.dead){
    let mx=(keys.KeyD?1:0)-(keys.KeyA?1:0)+touchState.lx;
    let my=(keys.KeyS?1:0)-(keys.KeyW?1:0)+touchState.ly;
    const l=Math.hypot(mx,my);
    if(l>1){mx/=l;my/=l}
    // Deep water/mud slows non-flying frogs by 35%
    const slowMult=(!me.fly&&inWater(me.x,me.y))?0.65:1.0;
    me.mvx=mx*me.sp*slowMult;me.mvy=my*me.sp*slowMult;
    me.x+=me.mvx*dt;me.y+=me.mvy*dt;
    if(Math.hypot(mx,my)>0.1){
      me.wf=((TT*10)|0)%2;
      me.v+=Math.sin(TT*22)*.9;
      if(Math.random()<dt*12)dust(me.x,me.y+12,slowMult<1?'#26c6da':'#66bb6a',1);
    }else me.wf=0;

    const door=wd.clear&&wd.rm<MAX_RM&&Math.abs(me.x-240)<20;
    me.x=clamp(me.x,M+9,W-M-9);me.y=clamp(me.y,door?2:M+9,H-M-9);pushOut(me,9);
    if(door&&me.y<M&&now()>nextT){nextT=now()+1100;sendE('next',{});snd(240,.4,'sine',.1,520)}

    let sx=(keys.ArrowRight?1:0)-(keys.ArrowLeft?1:0)+touchState.rx;
    let sy=(keys.ArrowDown?1:0)-(keys.ArrowUp?1:0)+touchState.ry;
    me.cd-=dt;
    if(Math.hypot(sx,sy)>0.15){me.ax=sx;me.ay=sy;if(me.cd<=0)fire()}

    // Heart Drops Pickup from Champions
    for(let i=DROPS.length-1;i>=0;i--){
      const dr=DROPS[i];spring(dr,dt);
      if(Math.hypot(dr.x-me.x,dr.y-me.y)<18&&me.hp<me.mh){
        me.hp=Math.min(me.mh,me.hp+1);
        FT.push({x:me.x,y:me.y-22,s:'+1 CORAÇÃO!',c:'#ff5252',l:1.0,b:1});
        pt(dr.x,dr.y,'#ff5252',16,90,.45,2.5);snd(580,.2,'triangle',.07,260);
        DROPS.splice(i,1);
      }
    }

    me.inv-=dt;
    if(me.inv<=0){
      let hit=false;
      for(const e of wd.en){
        if(Math.hypot(e.x-me.x,e.y-me.y)<RAD[e.t]*(e.chmp?1.2:1)+7){hit=true;break}
        if(e.seg)for(const sg of e.seg)if(Math.hypot(sg.x-me.x,sg.y-me.y)<18){hit=true;break}
      }
      if(!hit)for(const b of wd.eb)if(Math.hypot(b.x-me.x,b.y-me.y)<8){hit=true;sendE('ebx',{i:b.id});wd.eb=wd.eb.filter(x=>x!==b);break}
      // Retractable Floor Spikes Hazard Damage (if not flying)
      if(!hit&&!me.fly&&spikesUp()){
        for(const spk of hazards(wd.rm).spikes){
          if(Math.hypot(spk.x-me.x,spk.y-me.y)<13){hit=true;break}
        }
      }
      if(hit){
        me.inv=1.25;
        if(me.sh>0){
          me.sh--;pt(me.x,me.y,'#40c4ff',22,120,.5,3);snd(700,.2,'triangle',.08,-400);
          FT.push({x:me.x,y:me.y-24,s:'BOLHA BLOQUEOU!',c:'#40c4ff',l:.9});
        }else{
          roomDamaged=true;me.hp--;me.j=.55;fl=1;addShake(9);addHs(.09);
          pt(me.x,me.y,'#ff1744',16,115,.5,3,200);snd(150,.3,'sawtooth',.08,-100);
          if(me.hp<=0){me.hp=0;me.dead=true;pt(me.x,me.y,'#fff',32,140,.8,3);snd(100,.7,'sawtooth',.09,-60)}
        }
      }
    }
    if(now()>me.pk&&me.tookRm!==wd.rm){
      for(const it of wd.items){
        if(Math.hypot(it.x-me.x,it.y-me.y)<19){
          me.pk=now()+1400;me.tookRm=wd.rm;
          sendE('pick',{k:it.k,x:it.x,y:it.y,who:CH[me.ch].n,pid:me.id});
          got(it.k);break;
        }
      }
    }
  }

  for(const b of myB){
    if(me.hm&&!b.tng){
      let n=null,bd=26000;
      for(const e of wd.en){const d=(e.x-b.x)**2+(e.y-b.y)**2;if(d<bd){bd=d;n=e}}
      if(n){const s=Math.hypot(b.vx,b.vy),dx=n.x-b.x,dy=n.y-b.y,l=Math.hypot(dx,dy)||1,k=Math.min(1,dt*6);b.vx+=(dx/l*s-b.vx)*k;b.vy+=(dy/l*s-b.vy)*k}
    }
    b.x+=b.vx*dt;b.y+=b.vy*dt;b.l-=dt;
    if(Math.random()<.5)pt(b.x,b.y,WP[b.w].col,1,14,.25,1.6);

    const hitX=b.x<M||b.x>W-M,hitY=b.y<M||b.y>H-M,hitRk=!me.fly&&inRock(b.x,b.y);
    if(hitX||hitY||hitRk){
      if(b.bnc>0&&!b.tng){
        b.bnc--;if(hitX)b.vx*=-1;if(hitY||hitRk)b.vy*=-1;
        b.x=clamp(b.x,M+2,W-M-2);b.y=clamp(b.y,M+2,H-M-2);
        snd(340,.04,'triangle',.03,80);
      }else{
        b.l=0;triggerAoE(b);pt(b.x,b.y,WP[b.w].col,6,70,.3,2);snd(260,.05,'square',.02);
      }
    }
    for(const e of wd.en)if(b.l>0&&!b.hit.includes(e.id)&&Math.hypot(e.x-b.x,e.y-b.y)<RAD[e.t]*(e.chmp?1.2:1)+b.r){
      const kb=b.tng?18:(b.w==4?14:4.5);
      sendE('hit',{i:e.id,d:b.d,kx:Math.cos(b.ka)*kb,ky:Math.sin(b.ka)*kb});
      hitFx(e,b);b.hit.push(e.id);
      if(!b.p){b.l=0;triggerAoE(b)}
    }
  }
  myB=myB.filter(b=>b.l>0);

  // Full Co-op Player State Sync ('s')
  sT-=dt;if(sT<=0&&R&&R.connected()){
    sT=1/16;
    R.emit('s',{
      id:me.id,x:me.x|0,y:me.y|0,hp:me.hp,mh:me.mh,d:me.dead?1:0,c:me.ch,w:me.w,
      puff:+(me.puff>0),j:Math.round(me.j*100)/100,fly:me.fly?1:0,sh:me.sh,fam:me.fam,
      ax:Math.round(me.ax*100)/100,ay:Math.round(me.ay*100)/100,inv:me.inv>0?1:0,wf:me.wf
    }).catch(()=>{});
  }
  wT-=dt;if(wT<=0&&R&&R.connected()&&isHost()){
    wT=1/15;
    R.emit('w',{
      h:me.id,rm:wd.rm,c:+wd.clear,it:wd.items.map(i=>[i.x,i.y,i.k]),o:wd.over,
      en:wd.en.map(e=>[e.id,e.t,e.x|0,e.y|0,e.hp,e.tel>0?1:0,e.chmp||0]),
      eb:wd.eb.map(b=>[b.id,b.x|0,b.y|0,b.vx|0,b.vy|0])
    }).catch(()=>{});
  }
}

function partsUpd(dt){
  for(const p of P){
    p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=p.g*dt;p.vx*=1-dt*2;p.l-=dt;
    // Bouncing spit droplets/shells on floor
    if(p.bf&&p.y>p.bf&&p.vy>0){p.y=p.bf;p.vy*=-.55;p.vx*=.7}
  }
  for(let i=P.length-1;i>=0;i--)if(P[i].l<=0)P.splice(i,1);
  for(const f of FT){f.y-=30*dt;f.l-=dt}
  for(let i=FT.length-1;i>=0;i--)if(FT[i].l<=0)FT.splice(i,1);
  shake=Math.max(0,shake-dt*30);tr=Math.max(0,tr-dt*1.6);
}

// =============================================================================
// 12. 100% PIXEL ART RENDERER (ZERO EMOJIS!)
// =============================================================================
function T(s,x,y,c,a,sz){
  g.font='bold '+(sz||10)+'px "Trebuchet MS",monospace';
  g.textAlign=a||'left';g.lineWidth=3;g.strokeStyle='#000';g.lineJoin='round';
  g.strokeText(s,x,y);g.fillStyle=c||'#e8f5e9';g.fillText(s,x,y);
}
function dspr(s,x,y,j,al,f,sc=1){
  const h=s.height*sc,w=s.width*sc;g.save();
  g.globalAlpha=.32;g.fillStyle='#000';g.beginPath();g.ellipse(x,y+h/2,w*.4,3.5*sc,0,0,7);g.fill();
  g.globalAlpha=al??1;g.translate(x,y+h/2);g.scale((1+j)*sc,(1-j)*sc);g.drawImage(s,-s.width/2,-s.height);
  if(f>0){g.globalAlpha=.92;g.drawImage(sil(s,'#fff'),-s.width/2,-s.height)}
  g.restore();
}
function drawB(b,en){
  const c=en?'#ff5252':(b.col||WP[b.w]?.col||'#76ff03'),r=b.r||4;
  if(b.tng){
    // Elastic Frog Tongue Whip in Pixel Art (works for both local me and Co-op partner!)
    let ox=me.x,oy=me.y-6;
    if(b.oid&&b.oid!==me.id&&others[b.oid]){
      ox=others[b.oid].rx;oy=others[b.oid].ry-6;
    }
    g.strokeStyle='#ff4081';g.lineWidth=4;g.beginPath();g.moveTo(ox,oy);g.lineTo(b.x,b.y);g.stroke();
    g.strokeStyle='#ff80ab';g.lineWidth=1.5;g.beginPath();g.moveTo(ox,oy);g.lineTo(b.x,b.y);g.stroke();
  }
  g.globalCompositeOperation='lighter';g.globalAlpha=.7;g.drawImage(glow(c),b.x-r*4,b.y-r*4,r*8,r*8);
  g.globalCompositeOperation='source-over';g.globalAlpha=1;
  g.fillStyle=c;g.beginPath();g.ellipse(b.x,b.y,r*1.35,r*.9,Math.atan2(b.vy,b.vx),0,7);g.fill();
  g.fillStyle='#fff';g.beginPath();g.arc(b.x-1,b.y-1,r*.35,0,7);g.fill();
}
function hearts(x,y,hp,mh,sz,per){
  for(let i=0;i<mh;i++)g.drawImage(i<hp?S.h:S.h0,x+(i%per)*(sz+2),y+((i/per)|0)*(sz),sz,sz*.88);
}
function drawMenuBG(){
  const t=now()/1000,gr=g.createLinearGradient(0,0,0,H);
  gr.addColorStop(0,'#132a1c');gr.addColorStop(1,'#050b07');
  g.fillStyle=gr;g.fillRect(0,0,W,H);
  for(let i=0;i<7;i++){
    g.globalAlpha=.12;g.fillStyle=['#00e676','#29b6f6','#ffd54f'][i%3];
    g.beginPath();g.arc(70+i*60+Math.sin(t+i)*30,160+Math.cos(t*.7+i*2)*80,48+Math.sin(t*1.3+i)*12,0,7);g.fill();
  }
  g.globalAlpha=1;drawP();g.drawImage(VIG,0,0);
}
function drawP(){
  for(const p of P){
    const a=clamp(p.l/p.m*1.5,0,1),s=p.s*(.4+.6*a);
    g.globalAlpha=a;g.fillStyle=p.c;g.fillRect(p.x-s/2,p.y-s/2,s,s);
  }
  g.globalAlpha=1;
}

function drawFrogExtras(px,py,fly,sh,fam){
  if(fly){
    // Animated Dragonfly Wings behind flying frog
    const wy=py-10+Math.sin(TT*24)*2;
    g.globalAlpha=.85;g.drawImage(S.items[13],px-12,wy-8,24,18);g.globalAlpha=1;
  }
  if(sh>0){
    g.strokeStyle='#40c4ff';g.globalAlpha=.75;g.lineWidth=1.8;
    g.beginPath();g.arc(px,py-4,17,0,7);g.stroke();g.globalAlpha=1;
  }
  for(let f=0;f<(fam||0);f++){
    const fa=TT*3.5+f*3.14,fx=px+Math.cos(fa)*24,fy=py-4+Math.sin(fa)*16;
    g.drawImage(S.items[11],fx-8,fy-8,16,16);
  }
}

function draw(){
  g.setTransform(Z,0,0,Z,0,0);if(ST=='menu'){drawMenuBG();return}
  g.fillStyle='#000';g.fillRect(0,0,W,H);
  g.setTransform(Z,0,0,Z,(Math.random()-.5)*shake*Z,(Math.random()-.5)*shake*Z);
  const bIdx=biomeOf(wd.rm),th=TH[bIdx];
  g.drawImage(bg(wd.rm),0,0);

  // Water Ripples & Retractable Floor Spikes
  const hz=hazards(wd.rm);
  for(const w of hz.water){
    g.strokeStyle=th.a;g.globalAlpha=.25+Math.sin(TT*4)*0.08;g.lineWidth=1.2;
    g.beginPath();g.ellipse(w.x,w.y,w.rx*(.7+Math.sin(TT*2)*.1),w.ry*(.7+Math.cos(TT*2)*.1),0,0,7);g.stroke();
  }
  g.globalAlpha=1;
  const isUp=spikesUp(),isWrn=spikesWarn();
  for(const spk of hz.spikes){
    if(isWrn){
      g.fillStyle='#ff174455';g.fillRect(spk.x-12,spk.y-12,24,24);
    }
    const spSpr=S.spike[isUp?1:0];
    g.drawImage(spSpr,spk.x-spSpr.width/2,spk.y-spSpr.height/2);
  }

  // Persistent Splatter Decals & Bubbling Toxic Pools
  for(const d of DC){g.globalAlpha=.45;g.fillStyle=d.c;g.beginPath();g.ellipse(d.x,d.y,d.r,d.r*.55,0,0,7);g.fill()}
  for(const pl of POOLS){
    g.globalAlpha=clamp(pl.l,.2,.65);g.fillStyle=pl.c;
    g.beginPath();g.ellipse(pl.x,pl.y,pl.r+Math.sin(TT*10)*2,(pl.r+Math.cos(TT*10)*2)*.6,0,0,7);g.fill();
  }
  g.globalAlpha=1;

  // Champion Heart Drops on Floor
  for(const dr of DROPS){
    const by=Math.sin(TT*6+dr.id)*2.5;
    dspr(S.h,dr.x,dr.y+by,dr.j,1,0);
  }

  // Top Doorway
  if(wd.rm<MAX_RM){
    const o=wd.clear,gl=.6+Math.sin(TT*6)*.2;
    g.fillStyle=o?'#050a07':'#261914';g.fillRect(220,0,40,M);
    g.fillStyle=o?'#69f0ae':'#ff1744';g.globalAlpha=gl;g.fillRect(220,M-3,40,3);g.globalAlpha=1;
    if(!o){g.fillStyle='#140d0a';for(let i=0;i<4;i++)g.fillRect(226+i*8,2,3,M-6)}
    else{
      const ay=14+Math.sin(TT*8)*2;g.fillStyle='#69f0ae';
      g.fillRect(238,ay,4,8);g.fillRect(234,ay+4,12,2);g.fillRect(236,ay+2,8,2);
    }
  }

  // 4 Corner Pixel Art Torches + Dynamic Glows
  const tFrame=S.torch[((TT*8)|0)%2];
  const corners=[[M+8,M+8],[W-M-8,M+8],[M+8,H-M-10],[W-M-8,H-M-10]];
  g.globalCompositeOperation='lighter';
  for(const [x,y] of corners){g.globalAlpha=.5+Math.sin(TT*9+x)*.14;g.drawImage(glow('#ff9100'),x-38,y-38,76,76)}
  g.globalAlpha=1;g.globalCompositeOperation='source-over';
  for(const [x,y] of corners)g.drawImage(tFrame,x-tFrame.width/2,y-tFrame.height/2);

  // Item Pedestals with Pixel Art Icons
  for(const it of wd.items){
    const by=Math.sin(TT*4+it.x)*3,ic=S.items[it.k];
    g.fillStyle='#0006';g.beginPath();g.ellipse(it.x,it.y+12,14,4.5,0,0,7);g.fill();
    g.fillStyle='#455a64';g.fillRect(it.x-12,it.y+5,24,7);
    g.fillStyle='#78909c';g.fillRect(it.x-14,it.y+3,28,3);
    g.globalCompositeOperation='lighter';g.globalAlpha=.75;g.drawImage(glow('#ffd54f'),it.x-24,it.y-26+by,48,48);
    g.globalCompositeOperation='source-over';g.globalAlpha=1;
    g.drawImage(ic,it.x-ic.width/2,it.y-18+by);
    T(IT[it.k][0],it.x,it.y+25,'#ffd54f','center',8);
    T(IT[it.k][1],it.x,it.y+34,'#b9f6ca','center',7);
  }

  // Depth-Sorted Entities (Obstacles, 2-Frame Enemies & Champions, Bosses, Co-op Frogs)
  const L=[];
  const obSpr=S.obs[th.ob];
  for(const k of rocks(wd.rm))L.push([k.y+28,()=>{
    g.fillStyle='#0005';g.fillRect(k.x+3,k.y+24,26,6);
    g.drawImage(obSpr,k.x+2,k.y+4,28,24);
  }]);

  for(const e of wd.en)L.push([e.y,()=>{
    const bo=e.t.startsWith('B'),p2=bo&&e.hp<e.mh*.5;
    const animF=((Math.floor(TT*7+e.id))%2)===1;
    let s=bo?(p2?S[e.t+'_2']:(animF&&S[e.t+'_f2']?S[e.t+'_f2']:S[e.t])):(animF&&S[e.t+'_f2']?S[e.t+'_f2']:S[e.t]);
    const hop=(e.t=='m'||e.t=='n'||e.t=='B0')?Math.abs(Math.sin(TT*3.8+e.id))*.22-.08:0;
    const id=Math.sin(TT*6+e.id)*.05,tel=e.tel>0&&Math.floor(TT*20)%2;
    const al=e.t=='gho'?(.35+Math.sin(TT*5+e.id)*.25):1;
    const sc=e.chmp?1.28:1;

    // Champion Golden/Purple Aura Glow
    if(e.chmp){
      g.globalCompositeOperation='lighter';g.globalAlpha=.55+Math.sin(TT*8)*.15;
      g.drawImage(glow('#ffd54f'),(e.rx??e.x)-24,e.y-24,48,48);
      g.globalCompositeOperation='source-over';g.globalAlpha=1;
    }

    if(e.seg){
      for(let i=e.seg.length-1;i>=0;i--){
        const sg=e.seg[i];
        dspr(animF?S.m_f2:S.m,sg.x,sg.y,0,.9,e.fl>0?1:0);
      }
    }
    dspr(s,e.rx??e.x,e.y+(e.t=='f'||e.t=='B1'?Math.sin(TT*10+e.id)*3-6:0),e.j+id-hop,al,e.fl>0||tel?1:0,sc);
    if(bo){
      const cy=e.y-s.height-10+Math.sin(TT*6)*2;
      g.drawImage(S.crown,(e.rx??e.x)-S.crown.width/2,cy);
    }
  }]);

  // Co-op Partner Rendering with Full Visual Sync (puff, fly, shield, familiars, inv, j)
  for(const o of act())L.push([o.ry,()=>{
    const cIdx=o.c||0;
    const oSpr=o.puff?S.pPuff[cIdx]:(o.wf?S.pWalk[cIdx]:S.pIdle[cIdx]);
    const flyY=o.fly?Math.sin(TT*7+1)*4-5:0;
    const oAl=o.d?.35:(o.inv&&Math.floor(TT*14)%2?.4:1);
    dspr(oSpr,o.rx,o.ry+flyY,o.j||0,oAl,0);
    drawFrogExtras(o.rx,o.ry+flyY,o.fly,o.sh,o.fam);
    T(CH[cIdx].n,o.rx,o.ry-32+flyY,'#80cbc4','center',7);
    if(o.d)g.drawImage(S.skull,o.rx-S.skull.width/2,o.ry-26);
  }]);

  L.push([me.y,()=>{
    const mySpr=me.puff>0?S.pPuff[me.ch]:(me.wf?S.pWalk[me.ch]:S.pIdle[me.ch]);
    const flyY=me.fly?Math.sin(TT*7)*4-5:0;
    dspr(mySpr,me.x,me.y+flyY,me.j,me.dead?.35:(me.inv>0&&Math.floor(TT*14)%2?.4:1),fl>.6?1:0);
    drawFrogExtras(me.x,me.y+flyY,me.fly,me.sh,me.fam);
    if(me.dead)g.drawImage(S.skull,me.x-S.skull.width/2,me.y-26);
  }]);

  L.sort((a,b)=>a[0]-b[0]);for(const l of L)l[1]();

  // Hypno-Frog Brimstone Laser Beams (Local + Partner Synced)
  for(const bm of BEAMS){
    const ex=bm.x+Math.cos(bm.a)*480,ey=bm.y+Math.sin(bm.a)*480,al=bm.l/bm.m;
    g.save();g.globalAlpha=al;g.lineCap='round';
    g.strokeStyle=bm.col;g.lineWidth=bm.w*1.8;g.beginPath();g.moveTo(bm.x,bm.y);g.lineTo(ex,ey);g.stroke();
    g.strokeStyle='#fff';g.lineWidth=bm.w*.65;g.beginPath();g.moveTo(bm.x,bm.y);g.lineTo(ex,ey);g.stroke();
    g.restore();
  }

  for(const b of wd.eb)drawB(b,1);
  for(const b of myB.concat(rB))drawB(b);
  drawP();
  for(const f of FT){g.globalAlpha=clamp(f.l*2,0,1);T(f.s,f.x,f.y,f.c,'center',f.b?11:9)}
  g.globalAlpha=1;
  g.drawImage(VIG,0,0);
  if(fl>0){g.fillStyle='rgba(255,20,40,'+fl*.28+')';g.fillRect(0,0,W,H)}

  // ===========================================================================
  // HUD OVERLAY (100% PIXEL ART ICONS)
  // ===========================================================================
  hearts(8,8,me.hp,me.mh,14,8);
  if(me.sh>0)g.drawImage(S.sh,8,26,14,14);

  // Top Center 15-Room Biome Progression Bar + Tactical Template Subtitle
  const layTxt=isBossRm(wd.rm)?'COVIL DO CHEFE':LAYOUT_NMS[roomLayout(wd.rm)];
  T(`${th.nm.toUpperCase()} (${wd.rm+1}/15) · ${layTxt}`,240,11,'#a5d6a7','center',7.5);
  for(let i=0;i<=MAX_RM;i++){
    const px=156+i*12,py=21,bo=isBossRm(i);
    g.fillStyle=i==wd.rm?'#ffd54f':i<wd.rm?'#4caf50':'#263238';
    g.beginPath();g.arc(px,py,i==wd.rm?4.2:(bo?3.4:2.4),0,7);g.fill();
    if(bo)g.drawImage(S.crownSm,px-S.crownSm.width/2,py-11);
  }

  // Bottom Left Weapon & Pixel Art Inventory Strip
  const w=WP[me.w];
  T(`${w.nm}  DANO:${me.dm.toFixed(1)}  CAD:${(1/(me.rt*w.rt)).toFixed(1)}/s`,8,H-7,w.col,'left',9);
  me.its.slice(-14).forEach((k,idx)=>{
    g.drawImage(S.items[k],8+idx*16,H-28,14,14);
  });

  // Co-op Partner HUD (shifted slightly left so top-right touch buttons never overlap)
  const ot=act()[0];
  if(ot){
    T(CH[ot.c||0].n,W-78,12,'#80cbc4','right',8.5);
    hearts(W-78-(ot.mh||6)*9,15,ot.hp,ot.mh||6,7.5,10);
  }else if(R&&R.connected()){
    T('CO-OP ATIVO · aguardando parceiro',W-8,H-7,'#ffd54f','right',8);
  }

  // Boss Health Bar with Pixel Art Royal Crown
  const boss=wd.en.find(e=>e.t.startsWith('B'));
  if(boss){
    g.fillStyle='#000c';g.fillRect(130,34,220,9);
    g.fillStyle='#ff1744';g.fillRect(132,36,216*clamp(boss.hp/boss.mh,0,1),5);
    g.drawImage(S.crownSm,114,31);
    T(BOSS_NMS[boss.t]||'CHEFE',240,49,'#ffd54f','center',8);
  }

  if(wd.clear&&!wd.over)T('Sala limpa! Pegue 1 mutação e avance pela porta norte',240,62,'#69f0ae','center',9);
  if(hint>0)T('WASD move · SETAS cospem · R reinicia · ESC opções · M som',240,H-36,'#b0bec5','center',8);

  if(wd.over||lost()){
    g.fillStyle='#000c';g.fillRect(0,100,W,105);
    T(wd.over?'PÂNTANO CONQUISTADO!':'FIM DA LINHA, SAPINHO!',240,145,wd.over?'#69f0ae':'#ff5252','center',22);
    T('Pressione R (ou botão R no topo) para jogar novamente ou ESC para trocar de Sapo',240,174,'#ffd54f','center',9.5);
  }
  if(tr>0){g.fillStyle='rgba(0,0,0,'+tr+')';g.fillRect(0,0,W,H)}
}

let last=now();
(function loop(){
  const n=now();let dt=Math.min(.05,(n-last)/1000);last=n;const rdt=dt;
  if(hs>0){hs-=dt;dt*=.2}
  if(ST=='play')upd(dt,rdt);
  else if(Math.random()<.45)P.push({x:Math.random()*W,y:-5,vx:0,vy:55+Math.random()*55,l:6,m:6,c:'#69f0ae',s:2+Math.random()*2,g:25});
  partsUpd(dt);draw();requestAnimationFrame(loop);
})();
</script>
