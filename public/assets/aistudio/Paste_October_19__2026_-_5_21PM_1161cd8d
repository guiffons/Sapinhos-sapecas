let AC;
function snd(f,d,ty='square',v=.05,sl=0){
  if(CFG.muted||CFG.sfx<=0)return;
  try{
    AC=AC||new (window.AudioContext||window.webkitAudioContext)();
    if(AC.state==='suspended')AC.resume();
    const o=AC.createOscillator(),gn=AC.createGain(),t=AC.currentTime;
    const vol=v*CFG.sfx;
    o.type=ty;o.frequency.setValueAtTime(f,t);
    o.frequency.exponentialRampToValueAtTime(Math.max(28,f+sl),t+d);
    gn.gain.setValueAtTime(vol,t);gn.gain.exponentialRampToValueAtTime(.0008,t+d);
    o.connect(gn);gn.connect(AC.destination);o.start();o.stop(t+d);
  }catch(e){}
}
