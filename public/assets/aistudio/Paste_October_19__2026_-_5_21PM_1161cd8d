<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>SAPINHOS SAPECAS</title>
<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
<style>
:root{--bg:#09110d;--fg:#e8f5e9;--gold:#ffd54f;--accent:#43a047;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
html,body{height:100%;margin:0;background:radial-gradient(circle at center,#15291c 0%,#050a07 100%);color:var(--fg);font-family:"Trebuchet MS",Verdana,sans-serif;overflow:hidden;touch-action:none}
body{display:flex;align-items:center;justify-content:center}
#wrap{position:relative;--w:min(98vw,calc((100vh - 10px)*1.5));width:var(--w);font-size:calc(var(--w)/62)}
canvas#c{width:100%;height:auto;display:block;image-rendering:pixelated;border-radius:.65em;box-shadow:0 1.2em 3.5em #000e,0 0 0 .24em #2e573c,0 0 1.8em #43a04733}
#menu{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:1em 1.4em;text-align:center;background:radial-gradient(circle at 50% 35%,#12281c88 0%,#040906f2 90%);border-radius:.65em;z-index:20}
h1{margin:0;font:900 3.35em "Arial Black",Impact,sans-serif;letter-spacing:.04em;color:#b9f6ca;text-shadow:0 .06em 0 #2e7d32,0 .12em 0 #1b5e20,0 .2em 0 #0a260d,0 .32em .45em #000}
h1 span{display:inline-block;transform-origin:50% 100%;animation:jel 1.7s ease-in-out infinite;animation-delay:calc(var(--i)*.09s)}
@keyframes jel{0%,100%{transform:scale(1,1)}25%{transform:scale(1.15,.82)}50%{transform:scale(.88,1.15) translateY(-.08em)}75%{transform:scale(1.06,.94)}}
.sub{margin:-.15em 0 0;color:#a5d6a7;font-size:.92em;font-weight:800;text-shadow:0 .12em .25em #000;letter-spacing:.06em}

/* 2.5D Isaac-Style Carousel */
#wheel-area{position:relative;width:100%;height:15.2em;display:flex;align-items:center;justify-content:center;margin:.1em 0}
#carousel{position:relative;width:27.5em;height:14em;perspective:600px}
.frog-slot{position:absolute;left:50%;top:44%;transform:translate(-50%,-50%);cursor:pointer;transition:transform .32s cubic-bezier(.25,1.5,.5,1),opacity .25s,filter .25s;display:flex;flex-direction:column;align-items:center}
.frog-slot canvas{image-rendering:pixelated;animation:jel 1.5s infinite;transform-origin:50% 100%;filter:drop-shadow(0 .2em .25em #0009)}
.frog-slot .slot-ped{width:4.4em;height:1.1em;background:radial-gradient(ellipse at center,#4e6e58 0%,#233629 70%,#111a14 100%);border:.13em solid #769c82;border-radius:50%;margin-top:-.35em;box-shadow:0 .3em .5em #000b;transition:all .25s}
.frog-slot.active .slot-ped{background:radial-gradient(ellipse at center,#ffd54f 0%,#c79100 75%,#5c4300 100%);border-color:#fff59d;box-shadow:0 0 1.3em #ffd54f99}

.nav-arrow{background:linear-gradient(180deg,#264a33 0%,#172e1f 100%);border:.16em solid #66bb6a;color:#e8f5e9;width:2.6em;height:2.6em;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 .25em 0 #0d1c12,0 .4em .7em #000a;z-index:10;transition:transform .2s cubic-bezier(.3,2.2,.5,1),background .2s;padding:0}
.nav-arrow canvas{width:1.25em;height:1.25em;image-rendering:pixelated}
.nav-arrow:hover{transform:scale(1.14);background:linear-gradient(180deg,#336344 0%,#1f3d2a 100%);border-color:#ffd54f}
.nav-arrow:active{transform:translateY(.16em);box-shadow:0 .08em 0 #0d1c12}

/* Character Inspector Card */
#char-info{width:23.2em;background:linear-gradient(160deg,#122419f2 0%,#0b1710f5 100%);border:.17em solid #4caf50;border-radius:.8em;padding:.55em .85em;text-align:left;box-shadow:0 .5em 1.4em #000c,inset 0 0 .8em #43a04722;margin-left:1em;z-index:8}
#ci-head{display:flex;justify-content:space-between;align-items:baseline;border-bottom:.12em solid #294c36;padding-bottom:.2em;margin-bottom:.3em}
#ci-name{font:900 1.25em "Arial Black",sans-serif;color:#ffd54f;text-shadow:0 .08em 0 #000}
#ci-title{font-size:.8em;color:#81c784;font-style:italic}
.ci-row{font-size:.82em;margin:.2em 0;color:#dcedc8}
.ci-row b{color:#80cbc4}
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:.25em .7em;margin-top:.35em}
.stat-item{display:flex;align-items:center;justify-content:space-between;font-size:.75em;color:#b0bec5;font-weight:700}
.stat-bars{display:flex;gap:.12em}
.stat-bars i{width:.48em;height:.68em;background:#1c2b22;border:.05em solid #2e4738;border-radius:.12em;display:inline-block}
.stat-bars i.on{background:#66bb6a;border-color:#b9f6ca;box-shadow:0 0 .35em #66bb6a88}
.stat-bars i.on.gold{background:#ffd54f;border-color:#fff9c4;box-shadow:0 0 .35em #ffd54f88}
#ci-lock{margin-top:.35em;padding:.28em .45em;background:#3e1616dd;border:.12em solid #ef5350;border-radius:.4em;color:#ffcdd2;font-size:.75em;font-weight:800;display:none}

/* Controls & Multiplayer Row */
#row{display:flex;gap:.5em;align-items:center;flex-wrap:wrap;justify-content:center}
button.btn{font:900 .92em "Arial Black",sans-serif;color:#fff;background:linear-gradient(180deg,#4caf50 0%,#2e7d32 100%);border:.12em solid #81c784;border-radius:.65em;padding:.5em .9em;cursor:pointer;box-shadow:0 .26em 0 #1b5e20,0 .45em .7em #000b;transition:transform .22s cubic-bezier(.3,2.2,.5,1),filter .15s;display:inline-flex;align-items:center;gap:.4em;text-shadow:0 .08em 0 #0008}
button.btn canvas{width:1.15em;height:1.15em;image-rendering:pixelated;flex-shrink:0}
button.btn:hover{transform:scale(1.07,.95);filter:brightness(1.1)}
button.btn:active{transform:translateY(.22em);box-shadow:0 0 0 #1b5e20}
button.btn:disabled{background:#37474f;border-color:#546e7a;box-shadow:0 .2em 0 #263238;opacity:.55;cursor:not-allowed;transform:none;filter:none}
#go{background:linear-gradient(180deg,#7e57c2 0%,#4527a0 100%);border-color:#b39ddb;box-shadow:0 .26em 0 #281566,0 .45em .7em #000b}
#btn-ach{background:linear-gradient(180deg,#ffa000 0%,#e65100 100%);border-color:#ffe082;box-shadow:0 .26em 0 #8c3100,0 .45em .7em #000b}
#btn-opt{background:linear-gradient(180deg,#26a69a 0%,#00695c 100%);border-color:#80cbc4;box-shadow:0 .26em 0 #003d33,0 .45em .7em #000b}
#btn-sandbox{background:linear-gradient(180deg,#00acc1 0%,#006064 100%);border-color:#84ffff;box-shadow:0 .24em 0 #00363a;font-size:.8em;padding:.42em .75em}
input#code{width:6em;font:900 1em monospace;text-align:center;text-transform:lowercase;background:#09140d;color:#ffd54f;border:.16em solid #4caf50;border-radius:.55em;padding:.42em;box-shadow:inset 0 .15em .4em #000a}
#st{margin:0;min-height:1.2em;color:#ffe082;font-size:.86em;font-weight:800;text-shadow:0 .1em .2em #000}
.help{margin:0;font-size:.73em;color:#90a4ae;font-weight:700}

/* Modals (Achievements & Options) */
.modal-box{position:absolute;inset:1.3em;background:linear-gradient(160deg,#0d1b13fa 0%,#07100bfa 100%);border:.22em solid #ffd54f;border-radius:.85em;z-index:35;display:none;flex-direction:column;padding:1em 1.4em;box-shadow:0 0 4em #000f}
.modal-head{display:flex;justify-content:space-between;align-items:center;border-bottom:.14em solid #2e573c;padding-bottom:.5em;margin-bottom:.65em}
.modal-head h2{margin:0;font:900 1.45em "Arial Black",sans-serif;color:#ffd54f;letter-spacing:.04em;display:flex;align-items:center;gap:.45em;text-shadow:0 .1em 0 #000}
.modal-head h2 canvas{width:1.3em;height:1.3em;image-rendering:pixelated}
#ach-list{flex:1;overflow-y:auto;display:grid;grid-template-columns:1fr 1fr;gap:.55em;padding-right:.3em}
.ach-card{display:flex;align-items:center;gap:.65em;background:#112218;border:.13em solid #284733;border-radius:.55em;padding:.45em .65em;text-align:left;opacity:.58;filter:grayscale(.8)}
.ach-card.unlocked{opacity:1;filter:none;border-color:#ffd54f;background:linear-gradient(90deg,#1c3b28 0%,#112418 100%);box-shadow:0 0 .8em #ffd54f25}
.ach-card canvas{width:2.35em;height:2.35em;image-rendering:pixelated;flex-shrink:0}
.ach-info{flex:1;min-width:0}
.ach-card b{display:block;font-size:.85em;color:#ffd54f;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ach-card small{display:block;font-size:.71em;color:#c8e6c9;line-height:1.15}
.ach-prog-wrap{margin-top:.26em;display:flex;align-items:center;gap:.4em}
.ach-prog-bar{flex:1;height:.42em;background:#09130d;border:.06em solid #2e573c;border-radius:.25em;overflow:hidden}
.ach-prog-fill{height:100%;background:linear-gradient(90deg,#43a047,#ffd54f);transition:width .3s}
.ach-prog-txt{font:900 .65em monospace;color:#ffd54f}

/* Options Modal Specifics */
#opt-modal{inset:2.6em 7em;border-color:#80cbc4}
.opt-grid{flex:1;display:flex;flex-direction:column;justify-content:center;gap:.68em;padding:0 1.2em}
.opt-row{display:flex;align-items:center;justify-content:space-between;background:#12251b;border:.13em solid #2b4f39;border-radius:.6em;padding:.52em .85em}
.opt-lbl{display:flex;align-items:center;gap:.55em;font:800 .92em "Trebuchet MS",sans-serif;color:#e8f5e9}
.opt-lbl canvas{width:1.4em;height:1.4em;image-rendering:pixelated}
.opt-ctrl{display:flex;align-items:center;gap:.5em}
input[type=range].opt-slider{-webkit-appearance:none;appearance:none;width:8.5em;height:.55em;background:#09140e;border:.1em solid #4caf50;border-radius:.3em;outline:none}
input[type=range].opt-slider::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:1.1em;height:1.1em;background:#ffd54f;border:.12em solid #fff;border-radius:50%;cursor:pointer;box-shadow:0 .1em .3em #000}
.opt-val{font:900 .85em monospace;color:#ffd54f;min-width:3.2em;text-align:right}
.opt-foot{display:flex;justify-content:center;gap:.8em;margin-top:.6em;padding-top:.5em;border-top:.12em solid #294c36}

/* Steam-style Sliding Notification Toast */
#steam-toast{position:absolute;right:1em;bottom:1em;width:19.5em;background:linear-gradient(135deg,#1b2838 0%,#101822 100%);border:.15em solid #ffd54f;border-radius:.55em;padding:.55em .75em;display:flex;align-items:center;gap:.65em;box-shadow:0 .5em 1.6em #000e;transform:translateY(160%);transition:transform .38s cubic-bezier(.22,1.4,.36,1);z-index:50;pointer-events:none}
#steam-toast.show{transform:translateY(0)}
#steam-toast canvas{width:2.6em;height:2.6em;image-rendering:pixelated;flex-shrink:0}
.st-txt{text-align:left;overflow:hidden}
.st-lbl{font:900 .66em "Arial Black",sans-serif;color:#ffd54f;letter-spacing:.06em;text-transform:uppercase}
.st-nm{font-weight:900;font-size:.9em;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.st-ds{font-size:.72em;color:#90caf9}

/* Mobile Dual-Stick Touch Layer & Top HUD Bar */
#touch-layer{position:absolute;inset:0;z-index:15;pointer-events:none;display:none}
#touch-layer.active{display:block}
.touch-zone{position:absolute;top:2.8em;bottom:0;width:50%;pointer-events:auto;touch-action:none}
#tz-left{left:0}
#tz-right{right:0}
.joy-base{position:absolute;width:6.4em;height:6.4em;margin:-3.2em 0 0 -3.2em;border-radius:50%;background:radial-gradient(circle,#4caf5022 0%,#10221688 80%);border:.16em solid #81c78488;display:none;pointer-events:none;box-shadow:0 0 1em #0008}
.joy-knob{position:absolute;left:50%;top:50%;width:2.7em;height:2.7em;margin:-1.35em 0 0 -1.35em;border-radius:50%;background:radial-gradient(circle at 35% 35%,#fff59d 0%,#ffd54f 55%,#c79100 100%);border:.14em solid #fff;box-shadow:0 .2em .5em #000b}
#joy-r .joy-base{border-color:#ff80ab88;background:radial-gradient(circle,#ff408122 0%,#26101988 80%)}
#joy-r .joy-knob{background:radial-gradient(circle at 35% 35%,#ff80ab 0%,#ff4081 60%,#ad1457 100%)}

#hud-top-btns{position:absolute;top:.35em;right:.45em;display:none;gap:.38em;z-index:18}
#hud-top-btns.active{display:flex}
.hud-ibtn{background:#122419cc;border:.13em solid #66bb6a;border-radius:.45em;padding:.28em .42em;cursor:pointer;display:flex;align-items:center;gap:.25em;color:#e8f5e9;font:900 .7em "Arial Black",sans-serif;box-shadow:0 .18em 0 #0a140e;pointer-events:auto}
.hud-ibtn canvas{width:1.15em;height:1.15em;image-rendering:pixelated}
.hud-ibtn:active{transform:translateY(.12em)}
</style>
</head>
<body>
<div id="wrap">
  <canvas id="c" width="960" height="640"></canvas>

  <!-- IN-GAME DISCRETE TOP PIXEL ART BUTTONS (PAUSE / RESTART) -->
  <div id="hud-top-btns">
    <button class="hud-ibtn" id="hud-restart" title="Reiniciar (R)"><canvas id="ic-hud-rst" width="12" height="12"></canvas><span>R</span></button>
    <button class="hud-ibtn" id="hud-pause" title="Opções / Menu (ESC)"><canvas id="ic-hud-opt" width="12" height="12"></canvas><span>ESC</span></button>
  </div>

  <!-- DUAL-STICK VIRTUAL TOUCH OVERLAY -->
  <div id="touch-layer">
    <div class="touch-zone" id="tz-left"></div>
    <div class="touch-zone" id="tz-right"></div>
    <div id="joy-l" class="joy-base"><div class="joy-knob" id="knob-l"></div></div>
    <div id="joy-r" class="joy-base"><div class="joy-knob" id="knob-r"></div></div>
  </div>

  <!-- MAIN MENU -->
  <div id="menu">
    <div>
      <h1 id="title"></h1>
      <p class="sub">ROGUELIKE COOPERATIVO DE SAPINHOS CUSPIDORES · 100% PIXEL ART</p>
    </div>

    <!-- 2.5D ISAAC WHEEL + INSPECTOR -->
    <div id="wheel-area">
      <button class="nav-arrow" id="prev-ch" title="Anterior (A / Seta Esq)"><canvas id="ic-arr-l" width="12" height="12"></canvas></button>
      <div id="carousel"></div>
      <button class="nav-arrow" id="next-ch" title="Próximo (D / Seta Dir)"><canvas id="ic-arr-r" width="12" height="12"></canvas></button>

      <div id="char-info">
        <div id="ci-head">
          <span id="ci-name">Croak</span>
          <span id="ci-title">O Sapo do Brejo</span>
        </div>
        <div class="ci-row"><b>Arma:</b> <span id="ci-wp">Cuspe Ácido</span></div>
        <div class="ci-row"><b>Passiva:</b> <span id="ci-pas">Equilibrado e resiliente</span></div>
        <div class="stat-grid" id="ci-stats"></div>
        <div id="ci-lock"></div>
      </div>
    </div>

    <!-- PLAY & ONLINE CO-OP BAR -->
    <div id="row">
      <button class="btn" id="solo"><canvas id="ic-play" width="12" height="12"></canvas> JOGAR SOLO</button>
      <span style="font-size:.82em;color:#a5d6a7;font-weight:800">CO-OP SALA:</span>
      <input id="code" maxlength="10" placeholder="codigo">
      <button class="btn" id="go"><canvas id="ic-net" width="12" height="12"></canvas> ENTRAR / CRIAR</button>
      <button class="btn" id="btn-ach"><canvas id="ic-trp" width="12" height="12"></canvas> CONQUISTAS (<span id="ach-cnt">0/15</span>)</button>
      <button class="btn" id="btn-opt"><canvas id="ic-opt" width="12" height="12"></canvas> OPÇÕES</button>
    </div>

    <p id="st">Gire a roda de sapos (A/D) e comece a cuspir!</p>
    <p class="help">WASD move · SETAS cospem · R reinicia · ESC opções/menu · M som · Use o mesmo código com seu amigo (Online P2P ou outra aba)</p>
  </div>

  <!-- ACHIEVEMENTS MODAL -->
  <div id="ach-modal" class="modal-box">
    <div class="modal-head">
      <h2><canvas id="ic-trp-hd" width="16" height="16"></canvas> CONQUISTAS DO PÂNTANO (<span id="ach-cnt2">0/15</span>)</h2>
      <div style="display:flex;gap:.5em">
        <button class="btn" id="btn-sandbox">LIBERAR TUDO (SANDBOX)</button>
        <button class="btn" id="close-ach" style="background:linear-gradient(180deg,#e53935 0%,#b71c1c 100%);border-color:#ef9a9a;box-shadow:0 .22em 0 #690000">FECHAR</button>
      </div>
    </div>
    <div id="ach-list"></div>
  </div>

  <!-- OPTIONS & PAUSE MODAL -->
  <div id="opt-modal" class="modal-box">
    <div class="modal-head">
      <h2><canvas id="ic-opt-hd" width="16" height="16"></canvas> <span id="opt-title">OPÇÕES DO PÂNTANO</span></h2>
      <button class="btn" id="close-opt" style="background:linear-gradient(180deg,#e53935 0%,#b71c1c 100%);border-color:#ef9a9a;box-shadow:0 .22em 0 #690000">FECHAR</button>
    </div>
    <div class="opt-grid">
      <div class="opt-row">
        <div class="opt-lbl"><canvas id="ic-opt-sfx" width="12" height="12"></canvas> Volume dos Efeitos Sonoros (SFX)</div>
        <div class="opt-ctrl">
          <input type="range" id="opt-sfx-rng" class="opt-slider" min="0" max="100" step="5" value="80">
          <span class="opt-val" id="opt-sfx-val">80%</span>
          <button class="btn" id="opt-mute-btn" style="padding:.3em .55em;font-size:.78em">SOM ON</button>
        </div>
      </div>
      <div class="opt-row">
        <div class="opt-lbl"><canvas id="ic-opt-shk" width="12" height="12"></canvas> Intensidade do Screen Shake</div>
        <div class="opt-ctrl">
          <button class="btn" id="opt-shk-btn" style="padding:.35em .8em;font-size:.82em">NORMAL</button>
        </div>
      </div>
      <div class="opt-row">
        <div class="opt-lbl"><canvas id="ic-opt-hs" width="12" height="12"></canvas> Hit-Stop (Impacto Estilo GameMaker)</div>
        <div class="opt-ctrl">
          <button class="btn" id="opt-hs-btn" style="padding:.35em .8em;font-size:.82em">LIGADO</button>
        </div>
      </div>
      <div class="opt-row">
        <div class="opt-lbl"><canvas id="ic-opt-tch" width="12" height="12"></canvas> Controles Touch na Tela (Dual-Stick)</div>
        <div class="opt-ctrl">
          <button class="btn" id="opt-tch-btn" style="padding:.35em .8em;font-size:.82em">AUTO</button>
        </div>
      </div>
      <div class="opt-row">
        <div class="opt-lbl"><canvas id="ic-opt-fs" width="12" height="12"></canvas> Modo de Exibição</div>
        <div class="opt-ctrl">
          <button class="btn" id="opt-fs-btn" style="padding:.35em .8em;font-size:.82em">TELA CHEIA</button>
        </div>
      </div>
    </div>
    <div class="opt-foot">
      <button class="btn" id="opt-resume" style="display:none">CONTINUAR PARTIDA</button>
      <button class="btn" id="opt-quit" style="display:none;background:linear-gradient(180deg,#fb8c00 0%,#e65100 100%);border-color:#ffcc80;box-shadow:0 .24em 0 #8c3100">VOLTAR AO MENU PRINCIPAL</button>
    </div>
  </div>

  <!-- STEAM TOAST POPUP -->
  <div id="steam-toast">
    <canvas id="toast-ic" width="24" height="24"></canvas>
    <div class="st-txt">
      <div class="st-lbl">CONQUISTA DESBLOQUEADA!</div>
      <div class="st-nm" id="toast-nm">Nome</div>
      <div class="st-ds" id="toast-ds">Descrição</div>
    </div>
  </div>
</div>

<script>
// =============================================================================
// 1. CORE UTILITIES & 100% PROCEDURAL PIXEL ART ENGINE (ZERO EMOJIS!)
// =============================================================================
const $=id=>document.getElementById(id),clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),rnd=()=>(Math.random()*1e9)|0,now=()=>performance.now();
const W=480,H=320,M=32,Z=2,cv=$('c'),g=cv.getContext('2d');g.imageSmoothingEnabled=false;
function sr(s){return()=>(s=s*16807%2147483647)/2147483647}

function spr(rows,pal,s=2){
  const c=document.createElement('canvas');
  c.width=rows[0].length*s;c.height=rows.length*s;
  const x=c.getContext('2d');
  rows.forEach((r,y)=>[...r].forEach((ch,i)=>{if(pal[ch]){x.fillStyle=pal[ch];x.fillRect(i*s,y*s,s,s)}}));
  return c;
}
function copySprTo(src,dst){
  if(!src||!dst)return;
  dst.width=src.width;dst.height=src.height;
  const x=dst.getContext('2d');x.imageSmoothingEnabled=false;
  x.clearRect(0,0,dst.width,dst.height);x.drawImage(src,0,0);
}
const FL=new WeakMap();
function sil(s,col='#fff'){
