    const x=c.getContext('2d');x.drawImage(s,0,0);x.globalCompositeOperation='source-in';
    x.fillStyle=col;x.fillRect(0,0,c.width,c.height);m[col]=c;
  }
  return m[col];
}
const GL={};
function glow(c){
  return GL[c]||(GL[c]=(()=>{
