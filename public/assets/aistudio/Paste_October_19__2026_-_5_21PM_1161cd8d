  if(BG[rm])return BG[rm];
  const bIdx=biomeOf(rm),t=TH[bIdx],c=document.createElement('canvas');
  c.width=W;c.height=H;const x=c.getContext('2d'),r=sr(rm*41+11);
  x.fillStyle=t.w;x.fillRect(0,0,W,H);
  x.fillStyle=t.wl;
  for(let y=0;y<H;y+=16)for(let i=(y/16)%2*16-16;i<W;i+=32)x.fillRect(i+1,y+1,30,14);
  for(let i=0;i<13;i++)for(let j=0;j<8;j++){
    x.fillStyle=(i+j)%2?t.f1:t.f2;x.fillRect(M+i*32,M+j*32,32,32);
  }
  for(let i=0;i<180;i++){
    x.fillStyle=r()<.5?'#0004':'#fff1';
    x.fillRect(M+(r()*412|0),M+(r()*252|0),2,2);
  }
  // Deep Water / Mud / Acid Islands Hazard Zones
  const hz=hazards(rm);
  for(const w of hz.water){
    x.fillStyle=t.hz;
    x.beginPath();x.ellipse(w.x,w.y,w.rx+4,w.ry+4,0,0,7);x.fill();
    x.fillStyle=t.a;x.globalAlpha=.22;
    x.beginPath();x.ellipse(w.x,w.y,w.rx-2,w.ry-2,0,0,7);x.fill();
    x.globalAlpha=1;
  }
  // Decorative organic puddles & pixel skulls
  x.fillStyle=t.a;x.globalAlpha=.13;
  for(let i=0;i<5;i++){
    x.beginPath();x.ellipse(M+20+r()*376,M+20+r()*216,10+r()*18,6+r()*10,0,0,7);x.fill();
  }
  x.globalAlpha=.25;
  for(let i=0;i<4;i++)x.drawImage(S.skull,M+16+r()*380,M+16+r()*220);
  x.globalAlpha=1;
  for(let k=0;k<10;k++){
    x.fillStyle='rgba(0,0,0,'+(.42-k*.04)+')';
    x.fillRect(M,M+k,416,1);x.fillRect(M,H-M-1-k,416,1);
    x.fillRect(M+k,M,1,256);x.fillRect(W-M-1-k,M,1,256);
  }
  return BG[rm]=c;
}
const VIG=(()=>{
  const k=document.createElement('canvas');k.width=W;k.height=H;
  const x=k.getContext('2d'),r=x.createRadialGradient(240,160,95,240,160,290);
  r.addColorStop(0,'#0000');r.addColorStop(1,'#000b');x.fillStyle=r;x.fillRect(0,0,W,H);return k;
})();

