// 9. DUAL-STICK VIRTUAL TOUCH CONTROLS
// =============================================================================
function setupJoystick(zoneEl,baseEl,knobEl,isRight){
  let pid=null,ox=0,oy=0;
  const maxR=42;
  const onStart=e=>{
    if(pid!==null)return;
    const t=e.changedTouches?e.changedTouches[0]:e;
    pid=t.identifier??'m';
    const rect=$('touch-layer').getBoundingClientRect();
    ox=t.clientX-rect.left;oy=t.clientY-rect.top;
    baseEl.style.display='block';
    baseEl.style.left=ox+'px';baseEl.style.top=oy+'px';
    knobEl.style.transform='translate(0px,0px)';
    if(isRight){touchState.rActive=true;touchState.rx=0;touchState.ry=0}
    else{touchState.lActive=true;touchState.lx=0;touchState.ly=0}
  };
  const onMove=e=>{
    if(pid===null)return;
    const list=e.changedTouches||[e];
    for(const t of list){
      if((t.identifier??'m')===pid){
        const rect=$('touch-layer').getBoundingClientRect();
        const dx=(t.clientX-rect.left)-ox,dy=(t.clientY-rect.top)-oy;
        const d=Math.hypot(dx,dy)||1,cl=Math.min(maxR,d);
        const nx=dx/d*(cl/maxR),ny=dy/d*(cl/maxR);
        knobEl.style.transform=`translate(${(dx/d*cl).toFixed(1)}px,${(dy/d*cl).toFixed(1)}px)`;
        if(isRight){touchState.rx=d>6?nx:0;touchState.ry=d>6?ny:0}
        else{touchState.lx=d>6?nx:0;touchState.ly=d>6?ny:0}
      }
    }
  };
  const onEnd=e=>{
    if(pid===null)return;
    const list=e.changedTouches||[e];
    for(const t of list){
      if((t.identifier??'m')===pid){
        pid=null;baseEl.style.display='none';
        if(isRight){touchState.rActive=false;touchState.rx=0;touchState.ry=0}
        else{touchState.lActive=false;touchState.lx=0;touchState.ly=0}
      }
    }
  };
  zoneEl.addEventListener('touchstart',e=>{e.preventDefault();onStart(e)},{passive:false});
  zoneEl.addEventListener('touchmove',e=>{e.preventDefault();onMove(e)},{passive:false});
  zoneEl.addEventListener('touchend',e=>{e.preventDefault();onEnd(e)},{passive:false});
  zoneEl.addEventListener('touchcancel',e=>{e.preventDefault();onEnd(e)},{passive:false});
}
setupJoystick($('tz-left'),$('joy-l'),$('knob-l'),false);
setupJoystick($('tz-right'),$('joy-r'),$('knob-r'),true);

