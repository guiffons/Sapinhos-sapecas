function unlockAch(id){
  if(achData[id])return;
  const a=ACH_LIST.find(x=>x.id===id);if(!a)return;
  achData[id]=Date.now();
  toastQueue.push(a);
  if(id!=='all_chars'&&CH.every((_,i)=>isCharUnlocked(i))){
    const allA=ACH_LIST.find(x=>x.id==='all_chars');
    if(allA&&!achData['all_chars']){achData['all_chars']=Date.now();toastQueue.push(allA)}
  }
  saveProgress();
  renderCarousel();
  processToastQueue();
}

function getAchProgress(a){
  if(achData[a.id])return[a.max,a.max];
  if(a.id==='k20')return[Math.min(20,achStats.kills),20];
  if(a.id==='it3')return[Math.min(3,achStats.maxItems),3];
  if(a.id==='synergy')return[Math.min(5,achStats.maxItems),5];
  if(a.id==='big_dmg')return[Math.min(4.5,Math.round(achStats.maxDmg*10)/10),4.5];
  if(a.id==='all_chars')return[CH.filter((_,i)=>isCharUnlocked(i)).length,6];
